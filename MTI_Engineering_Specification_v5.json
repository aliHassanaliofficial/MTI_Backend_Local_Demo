        "non_circumvention_months": "INT",
        "status": "ENUM",
        "created_at": "TIMESTAMPTZ"
      }
    },
    "documents": {
      "columns": {
        "doc_id": "UUID PK",
        "deal_id": "UUID FK",
        "uploaded_by": "UUID FK",
        "type": "ENUM",
        "file_url": "VARCHAR",
        "checksum": "CHAR(64)",
        "version": "INT",
        "visibility": "ENUM",
        "uploaded_at": "TIMESTAMPTZ"
      }
    },
    "messages": {
      "columns": {
        "message_id": "UUID PK",
        "thread_id": "UUID FK",
        "sender_id": "UUID FK",
        "body": "TEXT",
        "created_at": "TIMESTAMPTZ"
      }
    },
    "commissions": {
      "columns": {
        "commission_id": "UUID PK",
        "deal_id": "UUID FK",
        "rate": "NUMERIC(5,4)",
        "basis": "ENUM",
        "status": "ENUM",
        "settlement_statement_id": "UUID FK",
        "created_at": "TIMESTAMPTZ"
      }
    },
    "escrow_records": {
      "columns": {
        "escrow_id": "UUID PK",
        "deal_id": "UUID FK",
        "provider_id": "UUID FK",
