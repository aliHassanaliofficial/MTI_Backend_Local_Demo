  "database_schema": {
    "users": {
      "columns": {
        "user_id": "UUID PK",
        "username": "VARCHAR UNIQUE",
        "role": "ENUM",
        "full_name": "VARCHAR",
        "email": "VARCHAR UNIQUE",
        "phone": "VARCHAR",
        "kyc_status": "ENUM",
        "training_status": "ENUM",
        "permissions": "JSONB",
        "created_at": "TIMESTAMPTZ",
        "updated_at": "TIMESTAMPTZ",
        "deleted_at": "TIMESTAMPTZ"
      }
    },
    "organizations": {
      "columns": {
        "org_id": "UUID PK",
        "legal_name": "VARCHAR",
        "country": "CHAR(2)",
        "kyb_status": "ENUM",
        "beneficial_owners": "JSONB",
        "created_at": "TIMESTAMPTZ",
        "updated_at": "TIMESTAMPTZ"
      }
    },
    "listings": {
      "columns": {
        "listing_id": "UUID PK",
        "org_id": "UUID FK",
        "type": "ENUM",
