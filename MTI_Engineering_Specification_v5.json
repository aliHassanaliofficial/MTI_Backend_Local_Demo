  "security_controls": [
    {
      "id": "SEC-001",
      "control": "TLS 1.2+ everywhere",
      "implementation": "HSTS + cert management"
    },
    {
      "id": "SEC-002",
      "control": "Encryption at rest",
      "implementation": "KMS-managed keys"
    },
    {
      "id": "SEC-003",
      "control": "MFA for admin",
      "implementation": "TOTP + recovery codes"
    },
    {
      "id": "SEC-004",
      "control": "RBAC least privilege",
      "implementation": "role-based policies"
    },
    {
      "id": "SEC-005",
      "control": "Immutable audit log",
      "implementation": "append-only table + hash chain"
    },
    {
      "id": "SEC-006",
      "control": "Rate limiting",
      "implementation": "Redis-based limits"
    },
    {
      "id": "SEC-007",
      "control": "Webhook signature verification",
      "implementation": "HMAC + timestamp"
    },
    {
      "id": "SEC-008",
      "control": "No card data storage",
      "implementation": "tokenization via provider"
    },
    {
      "id": "SEC-009",
      "control": "Encrypted backups",
      "implementation": "daily + quarterly restore test"
    },
    {
      "id": "SEC-010",
      "control": "WORM archive",
      "implementation": "object lock + offline copy"
    }
  ],
