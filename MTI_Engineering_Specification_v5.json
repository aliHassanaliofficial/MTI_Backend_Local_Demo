        "category": "VARCHAR",
        "country_of_origin": "CHAR(2)",
        "price": "NUMERIC(20,4)",
        "currency": "CHAR(3)",
        "moq": "INT",
        "lead_time_days": "INT",
        "status": "ENUM",
        "created_at": "TIMESTAMPTZ"
      }
    },
    "trade_requests": {
