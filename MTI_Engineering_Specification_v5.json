        "origin": "VARCHAR",
        "destination": "VARCHAR",
        "incoterm": "VARCHAR",
        "status": "ENUM",
        "created_at": "TIMESTAMPTZ"
      }
    },
    "disputes": {
      "columns": {
        "dispute_id": "UUID PK",
        "deal_id": "UUID FK",
        "status": "ENUM",
        "evidence": "JSONB",
        "resolution": "TEXT",
        "created_at": "TIMESTAMPTZ"
      }
    },
    "providers": {
      "columns": {
        "provider_id": "UUID PK",
        "legal_name": "VARCHAR",
        "service_type": "VARCHAR",
        "accreditation_body": "VARCHAR",
        "standard": "VARCHAR",
        "valid_from": "DATE",
        "valid_until": "DATE",
        "referral_status": "ENUM",
        "last_verified_at": "TIMESTAMPTZ"
      }
    },
    "audit_events": {
      "columns": {
        "event_id": "UUID PK",
        "actor_id": "UUID FK",
        "action": "VARCHAR",
        "entity": "VARCHAR",
        "entity_id": "UUID",
        "timestamp": "TIMESTAMPTZ",
        "metadata": "JSONB"
      }
    },
    "consent_records": {
      "columns": {
        "consent_id": "UUID PK",
        "user_id": "UUID FK",
        "type": "ENUM",
        "granted_at": "TIMESTAMPTZ",
        "revoked_at": "TIMESTAMPTZ"
      }
    }
  },
