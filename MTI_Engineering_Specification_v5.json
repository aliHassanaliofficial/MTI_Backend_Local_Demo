        "status": "ENUM",
        "created_at": "TIMESTAMPTZ",
        "updated_at": "TIMESTAMPTZ"
      }
    },
    "contracts": {
      "columns": {
        "contract_id": "VARCHAR PK",
        "deal_id": "UUID FK",
        "type": "ENUM",
