        "status": "ENUM",
        "created_at": "TIMESTAMPTZ"
      }
    },
    "offers": {
      "columns": {
        "offer_id": "UUID PK",
        "request_id": "UUID FK",
        "seller_org_id": "UUID FK",
        "price": "NUMERIC(20,4)",
