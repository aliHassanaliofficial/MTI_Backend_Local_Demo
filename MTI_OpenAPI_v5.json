{
  "openapi": "3.0.3",
  "info": {
    "title": "MTI Platform API",
    "version": "5.0"
  },
  "paths": {
    "/v1/auth/register": {
      "post": {
        "summary": "Create user account",
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad request"
          },
          "409": {
            "description": "Conflict"
          }
        }
      }
    },
    "/v1/auth/login": {
      "post": {
        "summary": "Authenticate user",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/v1/deals": {
      "post": {
        "summary": "Create deal",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/v1/deals/{id}": {
      "get": {
        "summary": "Get deal room",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/v1/webhooks/escrow": {
      "post": {
        "summary": "Escrow webhook",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Invalid signature"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}